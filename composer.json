{
    "name": "pollora/meilifacets",
    "description": "Faceted search, filtering and suggestions powered by Meilisearch for Pollora projects.",
    "type": "laravel-library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "pollora",
        "wordpress",
        "meilisearch",
        "search",
        "facets",
        "filters",
        "woocommerce"
    ],
    "authors": [
        {
            "name": "AmphiBee",
            "homepage": "https://amphibee.fr"
        },
        {
            "name": "Louis Boulanger",
            "email": "louis.boulanger.work@gmail.com",
            "homepage": "https://github.com/Loubal70"
        }
    ],
    "require": {
        "php": "^8.4",
        "amphibee/meiliscout": "dev-feat/meilifacets",
        "composer/installers": "^2.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "league/uri": "^7.5"
    },
    "conflict": {
        "pollora/framework": "<13.4 || >=14.0"
    },
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": {}
        },
        "installer-name": "MeiliFacets",
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\MeiliFacets\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\MeiliFacets\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "ext-dom": "*",
        "driftingly/rector-laravel": "^2.6",
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.6"
    },
    "suggest": {
        "ext-intl": "Orders facet values as the site language does; without it, NameOrder falls back to a byte comparison that misplaces accented labels."
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "refactor": "rector process --dry-run",
        "test": "phpunit --testsuite Unit",
        "test:host": "phpunit --testsuite Feature",
        "lint:js": "npm run lint",
        "types:js": "npm run typecheck",
        "test:js": "npm test",
        "build": "npm run build",
        "build:check": "npm run --silent build:check",
        "check": [
            "@lint",
            "@lint:js",
            "@types:js",
            "@refactor",
            "@test",
            "@test:js",
            "@build:check"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check formatting without changing anything.",
        "fix": "Apply the formatting the linter asks for.",
        "refactor": "Report what Rector would change, without changing it.",
        "test": "Run the tests that need nothing but this package.",
        "test:host": "Run the tests that need a host application, from the host project.",
        "lint:js": "Check the browser client for dead code and unused imports.",
        "types:js": "Type-check the browser client and its tests.",
        "test:js": "Run the browser client tests.",
        "build": "Bundle the browser client into resources/assets/dist.",
        "build:check": "Fail when the committed bundle does not match the sources.",
        "check": "Everything the module can verify on its own: the definition of done."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        }
    }
}
