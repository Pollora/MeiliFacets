{
    "name": "@pollora/meilifacets",
    "private": true,
    "license": "GPL-2.0-or-later",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "lint": "eslint bundle.ts playwright.config.ts resources/assets/ts tests/ts tests/playwright",
        "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tests/ts/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tests/playwright/tsconfig.json",
        "test": "node --test --test-timeout=10000 --experimental-test-coverage --test-coverage-include=\"resources/assets/ts/**\" --test-coverage-lines=94 --test-coverage-branches=90 --test-coverage-functions=90 \"tests/ts/*.test.ts\"",
        "build": "node bundle.ts",
        "build:check": "node bundle.ts --check",
        "test:playwright": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@~7.0.2",
        "esbuild": "0.28.2",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^21.0.4",
        "typescript": "npm:@typescript/typescript6@~6.0.2",
        "typescript-eslint": "^8.70.0"
    }
}
