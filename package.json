{
    "name": "@pollora/meilifacets",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.12"
    },
    "scripts": {
        "lint": "eslint bundle.ts resources/assets/ts tests/ts",
        "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tests/ts/tsconfig.json",
        "test": "node --test --experimental-test-coverage --test-coverage-include=\"resources/assets/ts/**\" --test-coverage-lines=94 --test-coverage-branches=90 --test-coverage-functions=90 \"tests/ts/*.test.ts\"",
        "build": "node bundle.ts",
        "build:check": "node bundle.ts --check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.5",
        "@typescript/native": "npm:typescript@~7.0.2",
        "esbuild": "0.28.2",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "typescript": "npm:@typescript/typescript6@~6.0.2",
        "typescript-eslint": "^8.70.0"
    }
}
