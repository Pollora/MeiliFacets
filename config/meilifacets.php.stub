<?php

declare(strict_types=1);

return [
    // Readable by every visitor: this key must be a search-only key.
    'browser' => [
        'url' => env('MEILI_PUBLIC_URL'),
        'key' => env('MEILI_SEARCH_KEY'),
    ],

    // `submit` waits for a validation, `immediate` searches on every ticked box.
    'apply_mode' => 'immediate',

    /*
     * A taxonomy left out falls back to its own name prefixed with `f_`, never
     * its bare name: a bare taxonomy name is a public WordPress query var, and
     * would filter twice. Renaming one breaks every link already shared.
     */
    'url_parameters' => [
        // 'product_cat' => 'category',
    ],

    // Only to move a reserved name off a collision: `sort`, `q`, `pg`, `min_price`, `max_price`.
    'query_parameters' => [
        // 'q' => 'search',
    ],

    'card' => [
        'eager' => 4,
        'image_size' => 'medium',
    ],

    // Caps the last reachable page, and costs memory on the engine.
    'engine' => [
        'reachable_hits' => 1000,

        // Values a facet may return. The engine caps at 100 on its own and cuts by global
        // count, before a facet narrows to the aisle being looked at. Raise it for a large
        // taxonomy; reindex to push it.
        'max_facet_values' => 1000,
    ],

    // Document fields returned beyond the card: each one travels with every hit.
    'displayed_attributes' => [],
];
