{
    "variantTaxonomies": ["pa_volume", "pa_scent", "pa_size", "12"],
    "cases": [
        {
            "case": "a filter met by one variant shows that variant",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml", "price": "26" } }
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml", "price": "39" }
        },
        {
            "case": "a filter met by several variants shows the cheapest and says there are several",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" } },
                    { "facets": { "pa_volume": ["100ml"] }, "price": 32, "fields": { "volume": "100ml" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml" } }
                ]
            },
            "selected": { "pa_volume": ["100ml", "400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "100ml", "several_variants": true }
        },
        {
            "case": "no filter keeps the card as projected",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml", "price": "26" } }
                ]
            },
            "selected": {},
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml, 15ml", "price": "26 – 39" }
        },
        {
            "case": "a filter outside the variant taxonomies keeps the card as projected",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml", "price": "26" } }
                ]
            },
            "selected": { "product_brand": ["acme"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml, 15ml", "price": "26 – 39" }
        },
        {
            "case": "a filter no variant meets keeps the card as projected",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml", "price": "26" } }
                ]
            },
            "selected": { "pa_volume": ["100ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml, 15ml", "price": "26 – 39" }
        },
        {
            "case": "crossed filters met by two different variants keep the card as projected",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["15ml"], "pa_scent": ["rose"] }, "price": 26, "fields": { "volume": "15ml" } },
                    { "facets": { "pa_volume": ["400ml"], "pa_scent": ["rose"] }, "price": 39, "fields": { "volume": "400ml" } },
                    { "facets": { "pa_volume": ["15ml"], "pa_scent": ["iris"] }, "price": 28, "fields": { "volume": "15ml iris" } }
                ]
            },
            "selected": { "pa_volume": ["400ml"], "pa_scent": ["iris"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml, 15ml", "price": "26 – 39" }
        },
        {
            "case": "a filter on a taxonomy a variant does not carry does not rule it out once another filter concerns it",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml", "price": "26" } }
                ]
            },
            "selected": { "pa_volume": ["400ml"], "product_brand": ["acme"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml", "price": "39" }
        },
        {
            "case": "under a ticked size, a price range keeps the variants priced within it, both ends included",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" } },
                    { "facets": { "pa_volume": ["100ml"] }, "price": 32.5, "fields": { "volume": "100ml" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml" } }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": 33, "max": 39 },
            "expected": { "title": "Lotion", "volume": "400ml" }
        },
        {
            "case": "under a ticked size, a price range with one end bounds that end only",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": {}, "price": 39, "fields": { "volume": "400ml" } },
                    { "facets": {}, "price": 32.5, "fields": { "volume": "100ml" } },
                    { "facets": {}, "price": 26, "fields": { "volume": "15ml" } }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 32.5 },
            "expected": { "title": "Lotion", "volume": "15ml", "several_variants": true }
        },
        {
            "case": "under a ticked size, a price range no variant meets keeps the card as projected",
            "card": {
                "title": "Lotion",
                "volume": "400ml, 15ml",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml", "price": "26" } }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": 40, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml, 15ml", "price": "26 – 39" }
        },
        {
            "case": "a lone matching variant never says there are several",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" } }
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml" }
        },
        {
            "case": "the cheapest of two at the same price is the first listed",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": {}, "price": 26, "fields": { "volume": "first" } },
                    { "facets": {}, "price": 26, "fields": { "volume": "second" } }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": 20, "max": null },
            "expected": { "title": "Lotion", "volume": "first", "several_variants": true }
        },
        {
            "case": "a card without variants is left as it is",
            "card": { "title": "Lotion", "volume": "15ml" },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml" }
        },
        {
            "case": "a variant without a finite price is not a variant, and the list never reaches the card",
            "card": {
                "title": "Lotion",
                "volume": "15ml",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": "39", "fields": { "volume": "400ml" } },
                    { "facets": { "pa_volume": ["400ml"] }, "fields": { "volume": "400ml" } },
                    "400ml"
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml" }
        },
        {
            "case": "a malformed variant list is dropped",
            "card": { "title": "Lotion", "variants": { "facets": {}, "price": 26 } },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": 20, "max": null },
            "expected": { "title": "Lotion" }
        },
        {
            "case": "facets holding no slug list carry nothing, so no size rules the variant out",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": ["400ml"], "price": 26, "fields": { "volume": "15ml" } }
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml" }
        },
        {
            "case": "a variant overrides any other field it holds",
            "card": {
                "title": "Lotion",
                "id": 7,
                "url": "/lotion",
                "variants": [
                    { "facets": {}, "price": 26, "fields": { "url": "/lotion?size=15ml", "image_url": "/15ml.jpg" } }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion", "id": 7, "url": "/lotion?size=15ml", "image_url": "/15ml.jpg" }
        },
        {
            "case": "a slug list stored as an object is read by its values",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": { "0": "400ml" } }, "price": 39, "fields": { "volume": "400ml" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml" } }
                ]
            },
            "selected": { "pa_volume": ["15ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml" }
        },
        {
            "case": "a variant list stored as an object indexed from zero is read as a list",
            "card": { "title": "Lotion", "variants": { "0": { "facets": {}, "price": 26, "fields": { "volume": "15ml" } } } },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion", "volume": "15ml" }
        },
        {
            "case": "an indexed object is read in index order, whatever order it was written in",
            "card": {
                "title": "Lotion",
                "variants": {
                    "1": { "facets": {}, "price": 26, "fields": { "volume": "one" } },
                    "0": { "facets": {}, "price": 26, "fields": { "volume": "zero" } }
                }
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion", "volume": "zero", "several_variants": true }
        },
        {
            "case": "a variant list stored as an object not indexed from zero is dropped",
            "card": {
                "title": "Lotion",
                "variants": {
                    "2": { "facets": {}, "price": 26, "fields": { "volume": "two" } },
                    "1": { "facets": {}, "price": 26, "fields": { "volume": "one" } }
                }
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion" }
        },
        {
            "case": "a variant list keyed by a zero-padded index is dropped",
            "card": { "title": "Lotion", "variants": { "00": { "facets": {}, "price": 26, "fields": { "volume": "15ml" } } } },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion" }
        },
        {
            "case": "a variant list keyed by a negative zero is dropped",
            "card": { "title": "Lotion", "variants": { "-0": { "facets": {}, "price": 26, "fields": { "volume": "15ml" } } } },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion" }
        },
        {
            "case": "a variant list keyed by name is dropped",
            "card": { "title": "Lotion", "variants": { "small": { "facets": {}, "price": 26, "fields": { "volume": "15ml" } } } },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion" }
        },
        {
            "case": "a variant cannot override the card id nor bring the variant fields back",
            "card": {
                "title": "Lotion",
                "id": 7,
                "variants": [
                    {
                        "facets": {},
                        "price": 26,
                        "fields": { "volume": "15ml", "id": 999, "variants": [1, 2], "several_variants": true }
                    }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion", "id": 7, "volume": "15ml" }
        },
        {
            "case": "a taxonomy with a numeric name is a taxonomy like another",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "12": ["a"] }, "price": 30, "fields": { "volume": "A" } },
                    { "facets": { "12": ["b"] }, "price": 20, "fields": { "volume": "B" } }
                ]
            },
            "selected": { "12": ["a"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "A" }
        },
        {
            "case": "a field with a numeric name is merged like another",
            "card": { "title": "Lotion", "variants": [{ "facets": {}, "price": 26, "fields": { "12": "x" } }] },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": 30 },
            "expected": { "title": "Lotion", "12": "x" }
        },
        {
            "case": "a lone matching variant out of stock is shown and said out of stock",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" }, "in_stock": false },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml" }, "in_stock": true }
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml", "out_of_stock": true }
        },
        {
            "case": "a matching variant in stock wins over a cheaper one out of stock, and is not one of several",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 10, "fields": { "volume": "400ml" }, "in_stock": false },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 30, "fields": { "volume": "15ml" }, "in_stock": true }
                ]
            },
            "selected": { "pa_volume": ["15ml", "400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml" }
        },
        {
            "case": "variants out of stock are left out of the several in stock",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 20, "fields": { "volume": "400ml" }, "in_stock": false },
                    { "facets": { "pa_volume": ["100ml"] }, "price": 32, "fields": { "volume": "100ml" }, "in_stock": true },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml" }, "in_stock": true }
                ]
            },
            "selected": { "pa_volume": ["15ml", "100ml", "400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml", "several_variants": true }
        },
        {
            "case": "when every matching variant is out of stock the cheapest is shown, one of several, out of stock",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" }, "in_stock": false },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "volume": "15ml" }, "in_stock": false }
                ]
            },
            "selected": { "pa_volume": ["15ml", "400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "15ml", "several_variants": true, "out_of_stock": true }
        },
        {
            "case": "a variant without a stock flag is in stock",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 10, "fields": { "volume": "400ml" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 30, "fields": { "volume": "15ml" }, "in_stock": false }
                ]
            },
            "selected": { "pa_volume": ["15ml", "400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml" }
        },
        {
            "case": "only false puts a variant out of stock",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 10, "fields": { "volume": "400ml" }, "in_stock": 0 },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 30, "fields": { "volume": "15ml" }, "in_stock": "no" }
                ]
            },
            "selected": { "pa_volume": ["15ml", "400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml", "several_variants": true }
        },
        {
            "case": "a variant cannot say itself out of stock through its fields",
            "card": {
                "title": "Lotion",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml", "out_of_stock": true }, "in_stock": true }
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml" }
        },
        {
            "case": "a chosen variant sets the module flags, whatever the projected card held",
            "card": {
                "title": "Lotion",
                "several_variants": true,
                "out_of_stock": true,
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" }, "in_stock": true }
                ]
            },
            "selected": { "pa_volume": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "volume": "400ml" }
        },
        {
            "case": "a card no filter concerns keeps the flags it was projected with",
            "card": {
                "title": "Lotion",
                "several_variants": true,
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "volume": "400ml" } }
                ]
            },
            "selected": {},
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "several_variants": true }
        },
        {
            "case": "a price range alone keeps the card as projected, as WooCommerce lists the product on its own range",
            "card": {
                "title": "Lotion",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_volume": ["400ml"] }, "price": 39, "fields": { "price": "39" } },
                    { "facets": { "pa_volume": ["15ml"] }, "price": 26, "fields": { "price": "26" } }
                ]
            },
            "selected": {},
            "price": { "min": 30, "max": 45 },
            "expected": { "title": "Lotion", "price": "26 – 39" }
        },
        {
            "case": "a size its variants do not carry rules none out, so the card follows the variant in stock",
            "card": {
                "title": "Shower gel",
                "price": "10 – 50",
                "variants": [
                    { "facets": { "pa_scent": ["rose"] }, "price": 10, "fields": { "price": "10" }, "in_stock": false },
                    { "facets": { "pa_scent": ["iris"] }, "price": 50, "fields": { "price": "50" } }
                ]
            },
            "selected": { "pa_size": ["400ml"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Shower gel", "price": "50" }
        },
        {
            "case": "a ticked facet outside the variant taxonomies keeps the card as projected, even when a variant carries it",
            "card": {
                "title": "Lotion",
                "price": "26 – 39",
                "variants": [
                    { "facets": { "pa_finish": ["matte"] }, "price": 39, "fields": { "price": "39" } },
                    { "facets": { "pa_finish": ["glossy"] }, "price": 26, "fields": { "price": "26" } }
                ]
            },
            "selected": { "pa_finish": ["matte"] },
            "price": { "min": null, "max": null },
            "expected": { "title": "Lotion", "price": "26 – 39" }
        }
    ]
}
